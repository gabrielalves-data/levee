{
  "name": "levee",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first local developer cost tracker",
  "main": "electron/main.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite client",
    "build": "vite build --config client/vite.config.js",
    "electron": "electron .",
    "dev": "concurrently \"npm run dev:client\" \"wait-on http://127.0.0.1:5173 && npm run electron\"",
    "test": "vitest run --config client/vite.config.js",
    "test:connectors": "node --test server/connectors/connectors.test.js"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "keytar": "^7.9.0",
    "node-cron": "^4.2.1",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tanstack/react-query": "^5.101.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
